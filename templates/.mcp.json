{
  "mcpServers": {
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://cf-agent-memory.YOUR_SUBDOMAIN.workers.dev/mcp",
        "--header",
        "X-Project-Id: YOUR_PROJECT_NAME",
        "--header",
        "Authorization: Bearer YOUR_AUTH_TOKEN"
      ]
    }
  }
}

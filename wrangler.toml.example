name = "cf-agent-memory"
main = "src/index.ts"
compatibility_date = "2025-04-01"

[vars]
EMBEDDING_MODEL = "@cf/baai/bge-base-en-v1.5"
EMBEDDING_DIMENSIONS = "768"
AUTH_TOKEN = "CHANGE_ME"  # Bearer token for service-to-service calls (MCP, agents, scripts)
# OBSERVATORY_PASSWORD: set as a secret, NOT in wrangler.toml.
#   npx wrangler secret put OBSERVATORY_PASSWORD
# This is the password for the visualizer browser login. Required to use
# the Observatory UI. AUTH_TOKEN bearer still works for non-browser clients.

[[d1_databases]]
binding = "DB"
database_name = "agent-memory"
database_id = "YOUR_D1_DATABASE_ID"  # Run: npx wrangler d1 create agent-memory
migrations_dir = "migrations"

[[vectorize]]
binding = "VEC_MESSAGES"
index_name = "cf-mem-messages"

[[vectorize]]
binding = "VEC_ENTITIES"
index_name = "cf-mem-entities"

[[vectorize]]
binding = "VEC_PREFERENCES"
index_name = "cf-mem-preferences"

[[vectorize]]
binding = "VEC_FACTS"
index_name = "cf-mem-facts"

[[vectorize]]
binding = "VEC_TRACES"
index_name = "cf-mem-traces"

[[kv_namespaces]]
binding = "CACHE"
id = "YOUR_KV_NAMESPACE_ID"  # Run: npx wrangler kv namespace create CACHE

[ai]
binding = "AI"

# Durable Object: per-scope WebSocket pub/sub for live memory events.
# One DO per {project_id}:{user_id}. Uses WebSocket hibernation so duration
# is only billed while handling messages, not while idle.
[[durable_objects.bindings]]
name = "EVENTS"
class_name = "MemoryEventsDO"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["MemoryEventsDO"]

# Observatory visualizer — static assets served at the worker root.
# /api/* and /mcp/* still hit the Hono router; everything else falls back
# to ./public (with index.html as the SPA entry).
[assets]
directory = "./public"
not_found_handling = "single-page-application"
